        function rollDice() {
            if (isRolling || players.length === 0) return;
            isRolling = true;
            document.getElementById('btnRollDice').disabled = true;

            playSound('dice');

            const dice = document.getElementById('dice');
            const rollValue = Math.floor(Math.random() * 6) + 1;

            const xRot = (Math.floor(Math.random() * 4) + 4) * 360;
            const yRot = (Math.floor(Math.random() * 4) + 4) * 360;

            let targetX = 0, targetY = 0;
            switch(rollValue) {
                case 1: targetX = 0; targetY = 0; break;
                case 2: targetX = 0; targetY = 180; break;
                case 3: targetX = 0; targetY = 90; break;
                case 4: targetX = 0; targetY = -90; break;
                case 5: targetX = -90; targetY = 0; break;
                case 6: targetX = 90; targetY = 0; break;
            }

            dice.style.transform = `rotateX(${xRot + targetX}deg) rotateY(${yRot + targetY}deg)`;

            setTimeout(() => {
                const cp = players[currentTurnIndex];
                logMessage(`🎲 ${cp.name} ทอยได้แต้ม ${rollValue}`, 'text-amber-300 font-bold');
                movePlayerStepByStep(cp, rollValue);
            }, 1050);
        }

        async function movePlayerStepByStep(player, steps) {
            for (let s = 0; s < steps; s++) {
                player.position++;
                
                if (player.position >= 35) {
                    player.position = 35;
                    renderBoardPawns();
                    playSound('correct');
                    await new Promise(r => setTimeout(r, 300));
                    break;
                }

                renderBoardPawns();
                playSound('dice');
                await new Promise(r => setTimeout(r, 220));
            }

            await handleTileLanding(player);
        }

        async function handleTileLanding(player) {
            const tile = BOARD_TILES[player.position];
            logMessage(`📍 ${player.name} ตกที่ช่อง [${tile.name}]`, 'text-cyan-300');

            switch (tile.type) {
                case 'QUESTION':
                    triggerQuestionCard();
                    break;

                case 'MISSION':
                    triggerMissionCard();
                    break;

                case 'TEST':
                    triggerQuestionCard(true);
                    break;

                case 'BONUS':
                    triggerBonusCard();
                    break;

                case 'FORWARD':
                    logMessage(`⏩ เดินหน้า +2 ช่อง!`, 'text-emerald-400');
                    await new Promise(r => setTimeout(r, 600));
                    player.position = Math.min(35, player.position + 2);
                    renderBoardPawns();
                    finishTurn();
                    break;

                case 'BACKWARD':
                    logMessage(`🔄 ถอยหลัง 1 ช่อง!`, 'text-rose-400');
                    await new Promise(r => setTimeout(r, 600));
                    player.position = Math.max(0, player.position - 1);
                    renderBoardPawns();
                    finishTurn();
                    break;

                case 'FITNESS':
                    triggerFitnessChallenge();
                    break;

                case 'SUPER':
                    player.score.bonus += 3;
                    recalcScore(player);
                    showBonusModal("SUPER SPORT! ⚡", "คุณได้รับคะแนนพลังพิเศษสปอร์ตโบนัส +3 คะแนนทันที!");
                    break;

                case 'RANDOM':
                    if (Math.random() > 0.5) triggerQuestionCard();
                    else triggerMissionCard();
                    break;

                case 'REST':
                    logMessage(`🛌 ช่องพักผ่อน เติมพลังกาย สบายๆ`, 'text-slate-400');
                    finishTurn();
                    break;

                case 'FINISH':
                    playSound('fanfare');
                    logMessage(`🏁 ${player.name} พิชิตเส้นชัย (FINISH) แล้ว!`, 'text-amber-300 font-extrabold');
                    checkGameOver();
                    break;

                default:
                    finishTurn();
                    break;
            }
        }


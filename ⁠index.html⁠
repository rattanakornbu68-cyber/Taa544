        function answerQuestion(selectedIdx, btnEl) {
            const optsBtns = document.getElementById('questionOptions').querySelectorAll('button');
            optsBtns.forEach(b => b.disabled = true);

            const feedback = document.getElementById('questionFeedback');
            feedback.classList.remove('hidden');

            const cp = players[currentTurnIndex];

            if (selectedIdx === currentQuestion.answer) {
                playSound('correct');
                btnEl.classList.replace('bg-slate-800', 'bg-emerald-600/80');
                btnEl.classList.add('border-emerald-400');
                feedback.className = "p-3 rounded-xl text-xs md:text-sm font-prompt leading-relaxed mb-4 bg-emerald-950/80 border border-emerald-500 text-emerald-200";
                feedback.innerHTML = `<strong>ถูกต้องครับ! 🎉 (+2 คะแนน)</strong><br>${currentQuestion.explain}`;
                
                cp.score.knowledge += 2;
                recalcScore(cp);
                logMessage(`✅ ${cp.name} ตอบคำถามถูกต้อง (+2 คะแนน)`, 'text-emerald-400');
            } else {
                playSound('wrong');
                btnEl.classList.replace('bg-slate-800', 'bg-rose-600/80');
                btnEl.classList.add('border-rose-400');
                
                optsBtns[currentQuestion.answer].classList.replace('bg-slate-800', 'bg-emerald-700/60');

                feedback.className = "p-3 rounded-xl text-xs md:text-sm font-prompt leading-relaxed mb-4 bg-rose-950/80 border border-rose-500 text-rose-200";
                feedback.innerHTML = `<strong>ยังไม่ถูกต้องครับ! ❌</strong><br>${currentQuestion.explain}`;
                logMessage(`❌ ${cp.name} ตอบคำถามยังไม่ถูกต้อง`, 'text-rose-400');
            }

            document.getElementById('btnConfirmQuestion').classList.remove('hidden');
        }

        function closeQuestionModal() {
            closeModal('questionModal');
            finishTurn();
        }

        function triggerMissionCard() {
            const randIdx = Math.floor(Math.random() * MISSION_BANK.length);
            currentMission = MISSION_BANK[randIdx];

            document.getElementById('missionTitle').innerText = currentMission.title;
            document.getElementById('missionDesc').innerText = currentMission.desc;
            document.getElementById('missionIcon').className = `fa-solid ${currentMission.icon}`;

            const timerBox = document.getElementById('timerContainer');
            timerBox.classList.add('hidden');
            document.getElementById('missionTimer').innerText = currentMission.time;

            openModal('missionModal');
        }

        function startMissionTimer() {
            let timeLeft = currentMission.time;
            const timerBox = document.getElementById('timerContainer');
            const timerEl = document.getElementById('missionTimer');
            timerBox.classList.remove('hidden');

            if (timerInterval) clearInterval(timerInterval);

            timerInterval = setInterval(() => {
                timeLeft--;
                timerEl.innerText = timeLeft;
                playSound('dice');

                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    playSound('correct');
                    timerEl.innerText = "หมดเวลา!";
                }
            }, 1000);
        }

        function completeMission(isSuccess) {
            if (timerInterval) clearInterval(timerInterval);
            closeModal('missionModal');

            const cp = players[currentTurnIndex];
            if (isSuccess) {
                playSound('correct');
                cp.score.mission += 3;
                recalcScore(cp);
                logMessage(`💪 ${cp.name} ทำภารกิจทางกายสำเร็จ! (+3 คะแนน)`, 'text-emerald-400 font-bold');
            } else {
                logMessage(`⏩ ${cp.name} ข้ามภารกิจทางกาย`, 'text-slate-400');
            }

            finishTurn();
        }

        function triggerFitnessChallenge() {
            const cp = players[currentTurnIndex];
            cp.score.bonus += 5;
            recalcScore(cp);
            showBonusModal("FITNESS CHALLENGE! 🔥", "คุณได้ตกช่องความท้าทายพิเศษ รับโบนัสความสมบูรณ์แข็งแรงของร่างกาย +5 คะแนนเต็ม!");
        }

        function triggerBonusCard() {
            const cp = players[currentTurnIndex];
            const pts = Math.floor(Math.random() * 3) + 1;
            cp.score.bonus += pts;
            recalcScore(cp);
            showBonusModal("โบนัสสุขภาพดี! ⭐", `คุณได้รับสิทธิ์โบนัสเพิ่ม +${pts} คะแนน!`);
        }

        function showBonusModal(title, msg) {
            playSound('correct');
            document.getElementById('bonusTitle').innerText = title;
            document.getElementById('bonusMessage').innerText = msg;
            openModal('bonusModal');
        }

        function closeBonusModal() {
            closeModal('bonusModal');
            finishTurn();
        }

        function recalcScore(player) {
            player.score.total = player.score.knowledge + player.score.mission + player.score.bonus;
            updateLeaderboard();
        }

        function finishTurn() {
            const winner = players.find(p => p.position >= 35);
            if (winner) {
                checkGameOver();
                return;
            }

            currentTurnIndex = (currentTurnIndex + 1) % players.length;
            if (currentTurnIndex === 0) {
                roundNumber++;
                document.getElementById('roundCounter').innerText = `รอบที่ ${roundNumber}`;
            }

            updateTurnDisplay();
            renderBoardPawns();

            isRolling = false;
            document.getElementById('btnRollDice').disabled = false;
        }

        function updateTurnDisplay() {
            if (players.length === 0) return;
            const cp = players[currentTurnIndex];
            
            const badge = document.getElementById('turnBadge');
            badge.innerText = cp.icon;
            badge.className = `w-12 h-12 rounded-2xl flex items-center justify-center text-2xl shadow-inner border-2 border-white/20 transition-all bg-gradient-to-tr ${cp.color}`;

            document.getElementById('turnPlayerName').innerText = cp.name;
        }

        function updateLeaderboard() {
            const list = document.getElementById('playersList');
            if (!list) return;

            const sorted = [...players].sort((a, b) => b.score.total - a.score.total);

            document.getElementById('playerCountBadge').innerText = `${players.length} คน`;
            if (sorted.length > 0) {
                document.getElementById('leaderName').innerText = `${sorted[0].name} (${sorted[0].score.total}p)`;
            }

            list.innerHTML = '';
            sorted.forEach((p, idx) => {
                const div = document.createElement('div');
                const isCurrent = (p.id === players[currentTurnIndex]?.id);
                div.className = `p-3 rounded-2xl border transition-all ${isCurrent ? 'bg-slate-800 border-amber-400 shadow-md' : 'bg-slate-900/60 border-slate-800'}`;
                
                div.innerHTML = `
                    <div class="flex items-center justify-between mb-1.5">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-lg bg-gradient-to-tr ${p.color} flex items-center justify-center text-xs shadow">${p.icon}</span>
                            <span class="font-bold text-sm text-white font-prompt">${p.name} ${idx === 0 ? '👑' : ''}</span>
                        </div>
                        <span class="font-extrabold text-base text-amber-300 font-mono">${p.score.total} <span class="text-xs font-normal text-slate-400 font-prompt">คะแนน</span></span>
                    </div>
                    <div class="grid grid-cols-3 gap-1 text-[10px] text-slate-400 font-prompt text-center bg-slate-950/50 p-1.5 rounded-xl border border-slate-800/80">
                        <div>❓ ความรู้: <strong class="text-cyan-400">${p.score.knowledge}</strong></div>
                        <div>🏃 ภารกิจ: <strong class="text-emerald-400">${p.score.mission}</strong></div>
                        <div>⭐ โบนัส: <strong class="text-amber-400">${p.score.bonus}</strong></div>
                    </div>
                `;
                list.appendChild(div);
            });
        }

        function checkGameOver() {
            const sorted = [...players].sort((a, b) => b.score.total - a.score.total);
            const winner = sorted[0];

            document.getElementById('winnerTitleName').innerText = `${winner.name} ชนะเลิศ! 🎉`;

            const finalContainer = document.getElementById('finalLeaderboardList');
            finalContainer.innerHTML = '';

            sorted.forEach((p, rank) => {
                const row = document.createElement('div');
                row.className = "flex items-center justify-between p-2.5 rounded-xl bg-slate-800/80 border border-slate-700 text-xs md:text-sm font-prompt";
                row.innerHTML = `
                    <div class="flex items-center gap-2">
                        <span class="font-bold text-amber-400">อันดับ ${rank + 1}</span>
                        <span>${p.icon} ${p.name}</span>
                    </div>
                    <span class="font-bold text-white">${p.score.total} คะแนน</span>
                `;
                finalContainer.appendChild(row);
            });

            openModal('winnerModal');

            if (window.confetti) {
                confetti({
                    particleCount: 120,
                    spread: 80,
                    origin: { y: 0.6 }
                });
            }
        }

        function logMessage(text, colorClass = '') {
            const logBox = document.getElementById('gameLog');
            if (!logBox) return;

            const p = document.createElement('p');
            p.className = `leading-relaxed ${colorClass}`;
            p.innerHTML = `<span class="text-slate-500">[${new Date().toLocaleTimeString('th-TH', {hour:'2-digit', minute:'2-digit'})}]</span> ${text}`;
            logBox.prepend(p);
        }

        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) modal.classList.remove('hidden');
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) modal.classList.add('hidden');
        }

        function confirmReset() {
            if (confirm("คุณต้องการเริ่มเกมใหม่ทั้งหมดใช่หรือไม่?")) {
                openModal('setupModal');
            }
        }
    </script>
</body>
</html>

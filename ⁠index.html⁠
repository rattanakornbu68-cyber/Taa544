        function getPerimeterCoordinates(total) {
            const list = [];
            // Top side: 0..10
            for (let c = 1; c <= 11; c++) list.push({ col: c, row: 1 });
            // Right side: 11..17
            for (let r = 2; r <= 8; r++) list.push({ col: 11, row: r });
            // Bottom side: 18..28
            for (let c = 10; c >= 1; c--) list.push({ col: c, row: 9 });
            // Left side: 29..35
            for (let r = 8; r >= 2; r--) list.push({ col: 1, row: r });

            return list;
        }

